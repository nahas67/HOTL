node_modules/
.next/
# The two other Next.js output locations. `.next/` above covers the default `distDir`, but a
# package configured with `output: 'export'` writes to `out/` and a linked deployment writes local
# build metadata to `.vercel/`. Neither may ever be tracked; scoping `out/` to apps/ keeps it from
# swallowing an unrelated directory elsewhere in the tree.
apps/*/out/
.vercel/
dist/
.turbo/
.env*
!.env.example
!**/.env.example
data/
*.log
playwright-report/
test-results/
.medusa/
.data/
.sites-checkout/
.repowise/
.secrets/
*.tsbuildinfo
artifacts/
desktop.ini
*.pem
*.p12
*.pfx
*.key
*.sqlite
*.sqlite3
# Binary snapshot archives must never be tracked. They embedded .git history and
# .data simulation state when committed. Build clean ones with
# scripts/build-share-archive.ps1, which excludes ignored state by construction.
*.zip
