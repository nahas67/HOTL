# Separate Medusa schema/database; never reuse the HOTL application tables.
MEDUSA_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotl_medusa
REDIS_URL=redis://localhost:6379/0
PORT=9000
STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3001,http://localhost:7001
MEDUSA_JWT_SECRET=replace-with-random-32-character-or-longer-secret
MEDUSA_COOKIE_SECRET=replace-with-another-random-32-character-secret
GUARDRAIL_URL=http://127.0.0.1:4300
MEDUSA_GUARDRAIL_TOKEN=replace-with-separate-random-service-credential
# No Stripe, supplier, or advertising write credentials belong in this service.
