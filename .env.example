# Local simulation. The launcher passes only each service's permitted settings.
HOTL_MODE=simulation
HOTL_INTERNAL_TOKEN=hotl-local-development-token
GUARDRAIL_URL=http://127.0.0.1:4100
GUARDRAIL_SERVICE_URL=http://127.0.0.1:4100
COMMERCE_URL=http://127.0.0.1:4400
ORCHESTRATOR_URL=http://127.0.0.1:4300
KILL_SWITCH_URL=http://127.0.0.1:4200
KILL_SWITCH_READ_TOKEN=hotl-demo-kill-read-token
KILL_SWITCH_OWNER_TOKEN=hotl-demo-kill-owner-token
KILL_SWITCH_DEMO_PASSWORD=confirm-local-stop

# Optional local services via docker compose -f infra/docker-compose.yml up -d
# DATABASE_URL=postgresql://hotl:hotl_local_password@127.0.0.1:5432/hotl
# REDIS_URL=redis://127.0.0.1:6379
# ENABLE_QUEUE_WORKERS=true
# ENABLE_SCHEDULED_RUNS=true

# Supabase: server validates sessions, owner allowlist and agent JWT audience.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_OWNER_IDS=
# OWNER_USER_IDS=
# HOTL_PUBLIC_ORIGIN=https://owner.example.com
# STOREFRONT_PUBLIC_ORIGIN=https://shop.example.com

# Model calls go exclusively through LiteLLM. Supply separate scoped virtual keys.
# LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# LITELLM_SOURCING_KEY=
# LITELLM_MARKETING_KEY=
# LITELLM_ORDER_KEY=
# LITELLM_SUPPORT_KEY=
# LITELLM_ORCHESTRATOR_KEY=
# LITELLM_MASTER_KEY is proxy administration only; never pass it to runtime agents.

# Production webhook validation; no Stripe write key belongs in commerce-core.
# STRIPE_WEBHOOK_SECRET=

# Read-only store integrations. Credentials are entered through the owner cockpit.
# Simulation creates a private local key in .secrets/connectors.key; preserve it.
# In deployed guardrail service, use a secret manager to supply this base64 32-byte key:
# CONNECTOR_ENCRYPTION_KEY=
# Exact trusted public HTTPS WooCommerce hostnames (no URLs, wildcards or private IPs):
# CONNECTOR_ALLOWED_WOOCOMMERCE_HOSTS=store.example.com

# Optional transactional guardrail persistence; separate from LangGraph DATABASE_URL.
# Apply the runtime ledger migration before setting these server-only values:
# GUARDRAIL_DATABASE_URL=postgresql://guardrail:password@127.0.0.1:5432/hotl
# GUARDRAIL_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# First-time initialization of a deliberately provisioned empty database ONLY.
# Remove after initialization. Never use this to recover missing production data.
# GUARDRAIL_INITIALIZE_EMPTY_DATABASE=true

# Production identity is bound to GUARDRAIL_WORKSPACE_ID. See docs/production-identity.md.
# GUARDRAIL_AUTHORIZATION_VERSION=1
# GUARDRAIL_TOKENS_VALID_AFTER=0
# GUARDRAIL_REVOKED_TOKEN_IDS=
# GUARDRAIL_REVOKED_SESSION_IDS=
# AGENT_JWT_KEYS={"rotation-key-id":"secret-from-secret-manager-at-least-32-bytes"}
# AGENT_SCOPE_LIMITS={"marketing_agent":["context","runs"]}

# Shopify OAuth is owned only by guardrails. Callback must be exact HTTPS.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# During an app-secret rotation only: accept old webhook signatures until an
# explicit UTC expiry no more than one hour ahead. Remove both values afterward.
# SHOPIFY_PREVIOUS_CLIENT_SECRET=
# SHOPIFY_PREVIOUS_CLIENT_SECRET_VALID_UNTIL=2026-09-24T12:00:00.000Z
# SHOPIFY_REDIRECT_URI=https://owner.example.com/api/shopify/oauth/callback
# SHOPIFY_WEBHOOK_ORIGIN=https://guardrails.example.com
# SHOPIFY_SCOPES=read_products,write_products,read_inventory,read_locations
# SHOPIFY_WORKER_ENABLED=true
# The simulation launcher NEVER passes SHOPIFY_STAGING_SHOPS.
# Set a dev-store allowlist directly in an isolated live-auth staging guardrail process
# only when running the documented owner-controlled provider drill. Not a production gate.
# SHOPIFY_STAGING_SHOPS=your-development-store.myshopify.com
# For a deliberately NEW staging file ledger only; never use as data recovery:
# GUARDRAIL_INITIALIZE_EMPTY_FILE=true
